{
  "name": "ai-appsec",
  "version": "0.1.0",
  "mcpName": "io.github.subodhkc/ai-appsec",
  "description": "Audit AI applications and agents for security risks before commit, PR, merge, or deployment. Deterministic findings with coverage and evidence receipts.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subodhkc/ai-appsec.git"
  },
  "homepage": "https://github.com/subodhkc/ai-appsec#readme",
  "bugs": {
    "url": "https://github.com/subodhkc/ai-appsec/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ai-appsec": "dist/mcp/index.js"
  },
  "keywords": [
    "ai-security",
    "ai-appsec",
    "application-security",
    "ai-application-security",
    "ai-agent-security",
    "agent-security",
    "ai-code-security",
    "ai-security-scanner",
    "security-audit",
    "security-scan",
    "security-scanner",
    "security-review",
    "code-security",
    "sast",
    "llm-security",
    "mcp",
    "mcp-security",
    "devsecops",
    "pre-commit-security",
    "pre-push-security",
    "pr-security",
    "security-evidence",
    "prompt-injection",
    "mcp-server",
    "model-context-protocol"
  ],
  "files": [
    "dist",
    "rules/public-core",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "TRADEMARKS.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "tsx --test tests/**/*.test.ts",
    "test:architecture": "tsx --test tests/architecture/**/*.test.ts",
    "test:security": "tsx --test tests/security/**/*.test.ts",
    "test:provenance": "tsx --test tests/provenance/**/*.test.ts",
    "test:contracts": "tsx --test tests/contracts/**/*.test.ts",
    "test:mcp": "tsx --test tests/mcp/**/*.test.ts",
    "test:evals": "tsx --test tests/evals/**/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "canonicalize": "4.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
